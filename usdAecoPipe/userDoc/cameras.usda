#usda 1.0
(
    upAxis = "Z"
    metersPerUnit = 1
)
def Scope "Renders" {
    def Camera "pipe_run" {
        token projection = "orthographic"
        float horizontalAperture = 75
        float verticalAperture = 46.875
        double3 xformOp:translate = (2, 2, 10)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
}
